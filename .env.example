# CicloMart Backend — environment variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env

PORT=3001
NODE_ENV=development

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Frontend URLs ---
# Internal address used for backend <-> frontend communication
FRONTEND_INTERNAL_URL=http://localhost:5173
# Publicly reachable address (used to build the MercadoPago callback URL)
FRONTEND_EXTERNAL_URL=http://localhost:5173

# --- Authentication ---
JWT_SECRET=

# --- Email (required to send verification codes) ---
EMAIL_ONLINE=
PASSWORD_ONLINE=
EMAIL_HOST=
EMAIL_PORT=

# --- MercadoPago (payment gateway) ---
# Publicly reachable backend URL (MercadoPago webhooks)
BACKEND_URL=http://localhost:3001
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=
MP_REDIRECT_URL=

# --- Encryption ---
# Basic: a single AES-256 key (exactly 32 characters).
# Generate with: openssl rand -base64 24 | head -c 32
AES_KEY=
# Advanced: versioned keys for rotation
# AES_KEY_V1=
# AES_CURRENT_VERSION=
# AWS KMS (recommended for production)
# KEY_PROVIDER=aws-kms
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=
