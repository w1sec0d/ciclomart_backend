{
  "name": "ciclomart_back",
  "version": "1.0.0",
  "description": "App backend de la aplicacion de ciclomart hecha con express",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "json-server": "json-server --watch test-db.json --port 4000",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark:encryption": "node benchmarks/encryption.benchmark.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "encrypt:migrate": "node scripts/migrate_encrypt_users.js",
    "kms:migrate": "node scripts/migrate_to_kms.js",
    "kms:reencrypt": "node scripts/reencrypt_kms.js",
    "kms:rotate": "node scripts/rotate_key.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.943.0",
    "@eslint/eslintrc": "^3.3.0",
    "@mysql/xdevapi": "^8.0.35",
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "json-server": "^1.0.0-beta.3",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.3.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.0",
    "nodemon": "^3.1.9"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "ajv": "^8.17.1",
    "whatwg-url": "^14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "!**/node_modules/**"
    ]
  }
}
